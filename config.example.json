{
  "enabled": false,
  "interval_seconds": 3600,
  "confirmation_delay_seconds": 60,
  "max_probe_requests_per_cycle": 6,
  "minimum_probability": 0.95,
  "maximum_expected_probability": 0.05,
  "state_dir": "./state",
