    {
      "id": "example-route",
      "base_url": "http://127.0.0.1:8080/v1",
      "api_key_env": "MODELTRACE_EXAMPLE_KEY",
      "model": "gpt-6-astra",
      "effort": "high"
    }
  ]
}
